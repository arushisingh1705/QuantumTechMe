# SiteGround deployment settings.
# These are DUMMY values. Replace them with your real details before deploying.
# Where to find them: Site Tools > Devs > SSH Keys Manager > (your key) > SSH Credentials

# SSH hostname or IP shown in SSH Credentials (e.g. ssh.yourdomain.com or 35.xxx.xxx.xxx)
SSH_HOST="ssh.quantumtechme.com"

# SiteGround uses port 18765 for SSH (not 22)
SSH_PORT="18765"

# SSH username shown in SSH Credentials (looks like u1234-abcd5678efgh)
SSH_USER="u2272-mgdzaauu36mg"

# Path to the private key you downloaded from SSH Keys Manager
SSH_KEY="$HOME/.ssh/siteground_key"

# Your domain exactly as it appears in Site Tools (folder under ~/www/)
DOMAIN="quantumtechme.com"

# Folder that holds the Laravel app, placed next to public_html (not inside it)
APP_DIR_NAME="laravel"

# PHP command on the server (SiteGround's "php" follows the version set in PHP Manager)
PHP_BIN="php"

# Run database migrations on every deploy (yes/no)
RUN_MIGRATIONS="yes"
